{
  "name": "component-intent-audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "component-intent-audit": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean",
    "dev": "tsx src/cli.ts",
