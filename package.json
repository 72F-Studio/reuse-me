    "benchmark:context": "npm run build && node scripts/context-benchmark.mjs"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.7",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
